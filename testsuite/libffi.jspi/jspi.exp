# Tests for Emscripten's JavaScript Promise Integration (JSPI). These
# build with -sJSPI and need a JS engine with JSPI enabled to run.

dg-init
libffi-init

global srcdir subdir

set tlist [lsort [glob -nocomplain -- $srcdir/$subdir/*.c]]

# JSPI only exists on Emscripten. emcc warns that -sJSPI is experimental,
# which would otherwise count as an excess error.
if { [istarget "wasm*-*-*"] } {
    run-many-tests $tlist "-sJSPI -Wno-experimental"
} else {
    foreach test $tlist {
        unsupported "$test"
    }
}

dg-finish

